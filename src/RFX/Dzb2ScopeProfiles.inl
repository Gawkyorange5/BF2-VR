// Sorted exact names; Survival aliases have already been canonicalized.
const ScopeProfile* Dzb2ScopeProfile(const char* name){
    unsigned lo=0,hi=sizeof(dzb2ScopeProfiles)/sizeof(dzb2ScopeProfiles[0]);
    while(lo<hi){const unsigned mid=lo+(hi-lo)/2;const int c=strcmp(name,dzb2ScopeProfiles[mid].name);
        if(!c)return &dzb2ScopeProfiles[mid];if(c<0)hi=mid;else lo=mid+1;}
    return nullptr;
}
