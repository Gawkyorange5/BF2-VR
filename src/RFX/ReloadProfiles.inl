const ReloadWeaponProfile* FindReloadWeapon(const char* name){
    if(!strcmp(name,"bf4_xm25_player")||!strcmp(name,"bf4_xm25_i7"))name="bf4_xm25";
    if(!strcmp(name,"rurif_ak101_b"))name="rurif_ak101";
if(!strcmp(name,"rurif_ak47_b"))name="rurif_ak47";
if(!strcmp(name,"rurrif_ak74u_b"))name="rurrif_ak74u";
    for(const auto& p:reloadWeapons)if(!strcmp(name,p.name)){
        if(p.magazineBone<55||p.magazineBone>=70||p.capacity<1||p.capacity>1000||
           !Rigid(p.magazineInstalled)||!Rigid(p.handleInstalled))return nullptr;
        if(p.reloadAmount<0||p.reloadAmount>1||(p.reloadAmount&&!Rigid(p.shellSocket))||
           (p.manualReturn&&!p.handleBone)||(p.cycleAfterShot&&!p.manualReturn))return nullptr;
        if(p.shotsPerCycle<1||p.shotsPerCycle>2||(p.shotsPerCycle>1&&!p.cycleAfterShot)||
           (p.pumpAction&&!p.manualReturn)||(p.magazineFollowsLatch&&(!p.magazineLatchBone||p.reloadAmount)))return nullptr;
        if(p.handleBone&&(p.handleBone<55||p.handleBone>=70||p.handleBone==p.magazineBone||
           p.handleTravel<=0||p.handleRequired<=0||p.handleRequired>p.handleTravel||
           Length(p.handleAxis)<.99f||Length(p.handleAxis)>1.01f))return nullptr;
        if(p.followerBone&&(p.followerBone<55||p.followerBone>=70||p.followerBone==p.magazineBone||p.followerBone==p.handleBone))return nullptr;
        if(p.magazineLatchBone&&(p.magazineLatchBone<55||p.magazineLatchBone>=70||
           p.magazineLatchBone==p.magazineBone||p.magazineLatchBone==p.handleBone||
           p.magazineLatchBone==p.followerBone||!Rigid(p.magazineLatchOpen)))return nullptr;
        if(p.nativeMeshParts&&(p.nativeMeshParts<2||p.nativeMeshParts>16||p.magazineBone>=54+p.nativeMeshParts||
           (p.handleBone&&p.handleBone>=54+p.nativeMeshParts)||(p.followerBone&&p.followerBone>=54+p.nativeMeshParts)))return nullptr;
        if(p.openBoltReady&&(!p.handleBone||p.handleKeyCount<2||!Rigid(p.handleEmptyInstalled)))return nullptr;
        if(p.hiddenReloadParts&&(!p.nativeMeshParts||p.hiddenReloadParts>=(1u<<p.nativeMeshParts)||
           (p.hiddenReloadParts&(1u<<(p.magazineBone-54)))||(p.handleBone&&(p.hiddenReloadParts&(1u<<(p.handleBone-54))))||
           (p.followerBone&&(p.hiddenReloadParts&(1u<<(p.followerBone-54))))))return nullptr;
        if(p.magazineFollowerParts&&(!p.nativeMeshParts||p.magazineFollowerParts>=(1u<<p.nativeMeshParts)||
           (p.magazineFollowerParts&1u)||(p.magazineFollowerParts&p.hiddenReloadParts)||
           (p.magazineFollowerParts&(1u<<(p.magazineBone-54)))||
           (p.handleBone&&(p.magazineFollowerParts&(1u<<(p.handleBone-54))))||
           (p.followerBone&&(p.magazineFollowerParts&(1u<<(p.followerBone-54))))||
           (p.magazineLatchBone&&(p.magazineFollowerParts&(1u<<(p.magazineLatchBone-54))))))return nullptr;
        if(p.revolver&&(!p.pistol||!p.magazineFollowsLatch||p.handleBone||p.reloadAmount||!p.loaderBone||
           p.loaderBone<55||p.loaderBone>=54+p.nativeMeshParts||p.loaderBone==p.magazineBone||
           p.loaderBone==p.magazineLatchBone||!Rigid(p.loaderFromMagazine)||
           p.cylinderFollowerParts>=(1u<<p.nativeMeshParts)||!p.cylinderFollowerParts||
           (p.cylinderFollowerParts&1u)||(p.cylinderFollowerParts&p.magazineFollowerParts)||
           (p.cylinderFollowerParts&(1u<<(p.loaderBone-54)))||
           (p.cylinderFollowerParts&(1u<<(p.magazineBone-54)))||
           (p.cylinderFollowerParts&(1u<<(p.magazineLatchBone-54)))))return nullptr;
        if(p.handleKeyCount){
            if(!p.handleKeys||p.handleKeyCount<2||p.handleKeyCount>32||p.handleKeys[0].distance!=0)return nullptr;
            for(unsigned i=0;i<p.handleKeyCount;++i){const auto& k=p.handleKeys[i];
                if(!Rigid(k.handle)||!Rigid(k.follower)||!std::isfinite(k.distance)||
                   (i&&k.distance<=p.handleKeys[i-1].distance))return nullptr;
            }
            if(std::abs(p.handleKeys[p.handleKeyCount-1].distance-p.handleTravel)>.001f)return nullptr;
        }
        return &p;
    }
    return nullptr;
}
